// MediCitas — esquema de datos (especificacion/03-modelo-de-datos.md)
// Las restricciones EXCLUDE, CHECK y los triggers no se pueden expresar aquí:
// viven en prisma/migrations/*/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN

  @@map("user_role")
}

enum DocumentType {
  CC
  TI
  CE
  PA

  @@map("document_type")
}

enum Gender {
  FEMALE
  MALE
  OTHER

  @@map("gender")
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED

  @@map("appointment_status")
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  ACCOUNT_CREATED

  @@map("notification_type")
}

model User {
  id             Int          @id @default(autoincrement())
  role           UserRole
  documentType   DocumentType @map("document_type")
  documentNumber String       @map("document_number") @db.VarChar(20)
  firstName      String       @map("first_name") @db.VarChar(60)
  lastName       String       @map("last_name") @db.VarChar(60)
  email          String       @unique(map: "users_email_unique") @db.VarChar(150)
  phone          String?      @db.VarChar(15)
  passwordHash   String       @map("password_hash") @db.VarChar(255)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz()

  patient               Patient?
  doctor                Doctor?
  notifications         Notification[]
  cancelledAppointments Appointment[]  @relation("CancelledBy")

  @@unique([documentType, documentNumber], map: "users_document_unique")
  @@index([role, isActive], map: "idx_users_role_active")
  @@map("users")
}

model Specialty {
  id          Int     @id @default(autoincrement()) @db.SmallInt
  name        String  @unique(map: "specialties_name_unique") @db.VarChar(80)
  description String? @db.VarChar(255)

  doctors Doctor[]

  @@map("specialties")
}

model Patient {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique(map: "patients_user_unique") @map("user_id")
  birthDate      DateTime @map("birth_date") @db.Date
  gender         Gender
  address        String?  @db.VarChar(120)
  healthProvider String?  @map("health_provider") @db.VarChar(80)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "patients_user_id_fkey")
  appointments Appointment[]

  @@map("patients")
}

model Doctor {
  id                         Int    @id @default(autoincrement())
  userId                     Int    @unique(map: "doctors_user_unique") @map("user_id")
  specialtyId                Int    @map("specialty_id") @db.SmallInt
  licenseNumber              String @unique(map: "doctors_license_unique") @map("license_number") @db.VarChar(30)
  appointmentDurationMinutes Int    @default(30) @map("appointment_duration_minutes") @db.SmallInt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "doctors_user_id_fkey")
  specialty    Specialty        @relation(fields: [specialtyId], references: [id], onDelete: Restrict, map: "doctors_specialty_id_fkey")
  schedules    DoctorSchedule[]
  appointments Appointment[]

  @@map("doctors")
}

model DoctorSchedule {
  id        Int      @id @default(autoincrement())
  doctorId  Int      @map("doctor_id")
  weekday   Int      @db.SmallInt
  startTime DateTime @map("start_time") @db.Time()
  endTime   DateTime @map("end_time") @db.Time()

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade, map: "doctor_schedules_doctor_id_fkey")

  @@unique([doctorId, weekday, startTime], map: "doctor_schedules_slot_unique")
  @@map("doctor_schedules")
}

model Appointment {
  id                 Int               @id @default(autoincrement())
  patientId          Int               @map("patient_id")
  doctorId           Int               @map("doctor_id")
  startsAt           DateTime          @map("starts_at") @db.Timestamptz()
  endsAt             DateTime          @map("ends_at") @db.Timestamptz()
  reason             String?           @db.VarChar(255)
  status             AppointmentStatus @default(BOOKED)
  notes              String?
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(255)
  cancelledByUserId  Int?              @map("cancelled_by_user_id")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime          @default(now()) @map("updated_at") @db.Timestamptz()

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict, map: "appointments_patient_id_fkey")
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict, map: "appointments_doctor_id_fkey")
  cancelledBy   User?          @relation("CancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull, map: "appointments_cancelled_by_fkey")
  notifications Notification[]

  @@index([patientId, startsAt(sort: Desc)], map: "idx_appointments_patient_starts_at")
  @@index([doctorId, startsAt], map: "idx_appointments_doctor_starts_at")
  @@index([status], map: "idx_appointments_status")
  @@map("appointments")
}

model Notification {
  id            Int              @id @default(autoincrement())
  userId        Int              @map("user_id")
  appointmentId Int?             @map("appointment_id")
  type          NotificationType
  message       String           @db.VarChar(500)
  readAt        DateTime?        @map("read_at") @db.Timestamptz()
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "notifications_user_id_fkey")
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade, map: "notifications_appointment_id_fkey")

  @@index([userId, readAt], map: "idx_notifications_user_unread")
  @@map("notifications")
}
